@startuml
skinparam defaultFontName "Droid Sans Fallback"
'==============================
'【Main method】（アクション分類・プレイヤー毎処理）
'==============================
|Main method|
start
:[5-1] 誘発したアクションを分類しバッファに追加;
note right
    「即時/通常 × メイン/クイック」で分類
end note
note right
    誘発したアクションのコントローラーは
    起因となったアクションのオーナー
    になります。
end note

while ([5-2] バッファは空か？) is (No) 
  ' 外部ループ：バッファに何らかのアクションが残っている限り処理する

  '-------------------------------------------
  '【即時：プレイヤー毎に処理】
  '-------------------------------------------
  while ([5-3] バッファにスピード=即時はあるか？) is (Yes)

    group 即時: プレイヤー毎に処理
    note
        順番はターンプレイヤーから
        ターンが回る順に行う
    end note

      :ターンプレイヤーから開始;

      repeat
        while ([5-4] 該当プレイヤーにスピード=即時があるか？) is (Yes)
          :[5-5] タイミング=メインの即時アクションを処理;
          note right
            別フロー（誘発アクション処理）呼び出し
          end note
          :[5-6] タイミング=クイックの即時アクションを処理;
          note right
            別フロー（誘発アクション処理）呼び出し
          end note
        endwhile (No)
        :[5-7] 次のプレイヤーへ;
      repeat while (全員チェックしたか？) is (No)
    end group
  endwhile (No)

  '-------------------------------------------
  '【通常：プレイヤー毎に処理】
  '-------------------------------------------
  while ([5-8] バッファにスピード=通常はあるか？) is (Yes)

    group 通常: プレイヤー毎に処理
    note
        順番はターンプレイヤーから
        ターンが回る順に行う
    end note

      :ターンプレイヤーから開始;

      repeat
        while ([5-9] 該当プレイヤーにスピード=通常があるか？) is (Yes)
          :[5-10] タイミング=メインの通常アクションを処理;
          note right
            別フロー（誘発アクション処理）呼び出し
          end note
          :[5-11] タイミング=クイックの通常アクションを処理;
          note right
            別フロー（誘発アクション処理）呼び出し
          end note
        endwhile (No)
        :[5-12] 次のプレイヤーへ;
      repeat while (全員チェックしたか？) is (No)
    end group
  endwhile (No)

endwhile (Yes)
stop
@enduml
